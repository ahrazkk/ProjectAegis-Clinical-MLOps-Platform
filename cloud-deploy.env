# Google Cloud Deployment Configuration
# =====================================
# Configuration for deploying Project Aegis to Google Cloud

# Cloud Run Service Names
FRONTEND_SERVICE=aegis-frontend
BACKEND_SERVICE=aegis-backend

# Google Cloud Project (set this to your project ID)
PROJECT_ID=your-project-id
REGION=us-central1

# Container Registry
REGISTRY=gcr.io/${PROJECT_ID}

# Build and Deploy Frontend
# -------------------------
# From project root:
#   docker build -f Dockerfile.prod -t ${REGISTRY}/aegis-frontend:latest \
#     --build-arg VITE_API_URL=https://your-backend-url.run.app/api/v1 .
#   docker push ${REGISTRY}/aegis-frontend:latest
#   gcloud run deploy aegis-frontend \
#     --image ${REGISTRY}/aegis-frontend:latest \
#     --platform managed \
#     --region ${REGION} \
#     --allow-unauthenticated \
#     --port 8080

# Build and Deploy Backend
# ------------------------
# From web/ directory:
#   docker build -t ${REGISTRY}/aegis-backend:latest .
#   docker push ${REGISTRY}/aegis-backend:latest
#   gcloud run deploy aegis-backend \
#     --image ${REGISTRY}/aegis-backend:latest \
#     --platform managed \
#     --region ${REGION} \
#     --allow-unauthenticated \
#     --port 8000 \
#     --memory 2Gi \
#     --cpu 2 \
#     --set-env-vars="DJANGO_SETTINGS_MODULE=ProjectAegis.settings,CORS_ALLOWED_ORIGINS=https://your-frontend.run.app"

# Environment Variables for Backend
# ----------------------------------
DJANGO_SETTINGS_MODULE=ProjectAegis.settings
CORS_ALLOWED_ORIGINS=*
DEBUG=False
SECRET_KEY=your-secret-key-here

# Neo4j Aura (Free Tier) - Recommended for cloud
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Redis (Optional - can use Cloud Memorystore or skip for basic deployment)
# REDIS_URL=redis://your-redis-host:6379
